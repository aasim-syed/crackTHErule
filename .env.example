# Groq API key (https://console.groq.com/keys) — used by the AI opponent, server-side only.
GROQ_API_KEY=
# Any long random string. Encrypts puzzle links so the rule can't be read from the URL.
PUZZLE_SECRET=
# Optional: override the AI model (default openai/gpt-oss-120b).
# AI_MODEL=openai/gpt-oss-20b
